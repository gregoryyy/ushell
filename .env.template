# ush development settings, adapted from ../kibitz/.env.example. Copy to .env and fill in what you
# use: cp .env.template .env
# .env is git-ignored; never commit real keys. Only `just ush …` reads it: the recipe runs ush from
# the source tree with these variables. The installed ush never reads .env files, since a .env in
# the current directory could otherwise redirect requests or swap keys. Under sudo, ush ignores all
# of these and uses the invoking user's settings from `ush ai configure`.

# Which provider answers // requests: anthropic | ollama
USH_PROVIDER=anthropic
# Model for that provider. Empty uses the configured one (`ush ai configure`; for Anthropic the
# default is claude-opus-5-5). For Ollama, a pulled model that supports tools (`ollama list`).
USH_MODEL=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Ollama (local, no key) ---
# Only addresses on this machine (loopback) are accepted. Ollama forwards cloud models (e.g.
# `…:cloud`) to ollama.com; ush then says so before each request.
USH_OLLAMA_URL=http://127.0.0.1:11434
