# ush development settings, adapted from ../kibitz/.env.example. Copy to .env and fill in what you
# use: cp .env.template .env
# .env is git-ignored; never commit real keys. Only `just ush …` reads it: the recipe runs ush from
# the source tree with these variables. The installed ush never reads .env files, since a .env in
# the current directory could otherwise redirect requests or swap keys. Under sudo, ush ignores all
# of these and uses the invoking user's settings from `ush ai configure`.

# Which provider answers // requests: anthropic | ollama
USH_PROVIDER=anthropic

# Model for that provider. Empty uses the configured one (`ush ai configure`; for Anthropic the
# default is claude-opus-5-5). Uncomment one line of the provider's menu, or set your own.
#
# Anthropic, larger to smaller (cost and speed follow size):
#USH_MODEL=claude-opus-5-5       # default; best at long, multi-step investigations
#USH_MODEL=claude-sonnet-5-5     # faster and cheaper; enough for most requests
#USH_MODEL=claude-haiku-5-5      # fastest and cheapest; quick lookups
#
# Ollama: the model must support tools; `ollama pull <model>` first. Download size of the default
# 4-bit weights; Ollama needs that much memory plus 1–3 GB for a 32k context
# (OLLAMA_CONTEXT_LENGTH=32768 ollama serve). Checked against ollama.com/library on 2026-10-27.
#USH_MODEL=qwen3.5:2b            # 2.7 GB; too small to investigate, fine as the checker
#USH_MODEL=qwen3.5:4b            # 3.3 GB; simple requests on 8 GB machines
#USH_MODEL=qwen3.5:9b            # 6.6 GB; the best fit for 16 GB machines
#USH_MODEL=qwen3.5:27b           # 17 GB; good multi-step work; 32 GB or more
#USH_MODEL=qwen3.5:35b-a3b       # 22 GB; mixture of experts, fast for its size; 32 GB or more
#USH_MODEL=gemma4:12b            # 7.7 GB; an alternative family for 16 GB machines
# Avoid models of 3B and below for the agent (llama3.2:3b answers without running commands).
USH_MODEL=

# Checker: a second, independent model that judges each proposed command against your requests
# only (never command output) before it runs; what it flags needs your approval. provider:model,
# empty or off for none. A small model is enough, but not a tiny one: in a 7-case check on
# 2026-10-27 (ush SECTEST), llama3.2:3b caught 4 of 4 attacks with 1 false alarm in 3 harmless
# commands, while qwen2.5:1.5b let 3 of 4 attacks pass.
#USH_CHECKER=ollama:llama3.2:3b           # local, 2.0 GB; the tested choice
#USH_CHECKER=ollama:qwen3.5:4b            # local, 3.3 GB; newer, not yet measured
#USH_CHECKER=anthropic:claude-haiku-5-5   # needs the Anthropic key; requests and commands go there
USH_CHECKER=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Ollama (local, no key) ---
# Only addresses on this machine (loopback) are accepted. Ollama forwards cloud models (e.g.
# `…:cloud`) to ollama.com; ush then says so before each request.
USH_OLLAMA_URL=http://127.0.0.1:11434
